[Unit]
Description=AI Face Recognition Attendance System Backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Attendance-System
ExecStart=/usr/bin/python3 /home/pi/Attendance-System/run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
